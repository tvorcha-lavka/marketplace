#: .\src\apps\email\choices.py:6
msgid "Email Verification"
msgstr "Підтвердження електронної пошти"

#: .\src\apps\email\choices.py:7
msgid "Reset Password"
msgstr "Скидання пароля"

#: .\src\apps\email\tasks.py:20
#: .\src\apps\email\templates\email_verification.html:7
msgid "Email verification"
msgstr "Підтвердження електронної пошти"

#: .\src\apps\email\tasks.py:21
#, python-format
msgid ""
"Hi!\n"
"Your confirmation code: %(code)s"
msgstr ""
"Вітаю!\n"
"Ваш код підтвердження: %(code)s"

#: .\src\apps\email\tasks.py:22
msgid "Please check your email to verify your account."
msgstr ""
"Будь ласка, перевірте електронну пошту, щоб підтвердити ваш обліковий запис."

#: .\src\apps\email\tasks.py:37
#: .\src\apps\email\templates\reset_password.html:7
msgid "Password change confirmation"
msgstr "Підтвердження для зміни пароля"

#: .\src\apps\email\tasks.py:38
#, python-format
msgid ""
"Hi %(username)s!\n"
"Your password change confirmation code: %(code)s"
msgstr ""
"Вітаю %(username)s!\n"
"Ваш код підтвердження зміни пароля: %(code)s"

#: .\src\apps\email\tasks.py:43
msgid "A password reset email has been sent to your email address."
msgstr "На вашу електронну адресу було надіслано лист для зміни паролю."

#: .\src\apps\email\tasks.py:90
msgid "Welcome to Tvorcha Lavka!"
msgstr "Вітаємо у Tvorcha Lavka!"

#: .\src\apps\email\tasks.py:91
#, python-format
msgid "Hi, %(username)s. Thank you for registering Tvorcha Lavka!"
msgstr "Вітаю, %(username)s. Дякуємо, що зареєструвалися на Tvorcha Lavka!"

#: .\src\apps\email\templates\email_verification.html:12
msgid "Hi!"
msgstr "Вітаю!"

#: .\src\apps\email\templates\email_verification.html:15
msgid "Your confirmation code:"
msgstr "Ваш код підтвердження:"

#: .\src\apps\email\templates\email_verification.html:19
#: .\src\apps\email\templates\reset_password.html:19
#, python-format
msgid "Code is valid for %(expire_in)s minutes."
msgstr "Термін дії коду - %(expire_in)s хв."

#: .\src\apps\email\templates\email_verification.html:20
msgid "Please enter this code on the website to confirm your email address."
msgstr ""
"Будь ласка, введіть цей код на сайті, щоб підтвердити свою електронну пошту."

#: .\src\apps\email\templates\email_verification.html:23
msgid "If you have not requested this verification, please ignore this email."
msgstr "Якщо ви не запитували цю перевірку, будь ласка, ігноруйте цей лист."

#: .\src\apps\email\templates\reset_password.html:12
msgid "Hi, "
msgstr "Вітаю, "

#: .\src\apps\email\templates\reset_password.html:15
msgid "Your password change confirmation code:"
msgstr "Ваш код підтвердження зміни пароля:"

#: .\src\apps\email\templates\reset_password.html:20
msgid "Please enter this code on the website to confirm the password change."
msgstr "Будь ласка, введіть цей код на сайті, щоб підтвердити зміну пароля."

#: .\src\apps\email\templates\reset_password.html:23
msgid "If you have not requested a password change, please ignore this email."
msgstr "Якщо ви не надсилали запит на зміну пароля, ігноруйте цей лист."

#: .\src\apps\email\views.py:30
msgid "Email already verified."
msgstr "Електронну пошту вже підтверджено."
