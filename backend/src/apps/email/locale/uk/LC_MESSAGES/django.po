msgid "Email verification"
msgstr "Підтвердження електронної пошти"

msgid "Password recovery"
msgstr "Відновлення паролю"

msgid "Hi! Your email verification code: <VERIFICATION_CODE>"
msgstr "Вітаю! Ваш код підтвердження електронної пошти: <VERIFICATION_CODE>"

msgid "Please check your email to verify your account."
msgstr "Будь ласка, перевірте електронну пошту, щоб підтвердити ваш обліковий запис."

msgid "Welcome to Tvorcha Lavka!"
msgstr "Вітаємо у Tvorcha Lavka!"

msgid "Hi! Thank you for registering on Tvorcha Lavka!"
msgstr "Вітаю! Дякуємо, що зареєструвалися на Tvorcha Lavka!"

msgid "Hi! Your password recovery code: <VERIFICATION_CODE>"
msgstr "Вітаю! Ваш код відновлення паролю: <VERIFICATION_CODE>"

msgid "A password recovery email has been sent to your email address."
msgstr "На вашу електронну адресу було надіслано лист для відновлення паролю."

msgid "Your confirmation code:"
msgstr "Ваш код підтвердження:"

#, python-format
msgid "Code is valid for %(expire_in)s minutes."
msgstr "Термін дії коду - %(expire_in)s хв."

msgid "Please enter this code on the website to confirm your email address."
msgstr "Будь ласка, введіть цей код на сайті, щоб підтвердити свою електронну пошту."

msgid "If you have not requested this registration, please ignore this email."
msgstr "Якщо ви не запитували цю реєстрацію, будь ласка, ігноруйте цей лист."

msgid "You have successfully registered for Tvorcha Lavka. We are glad to see you among our users!"
msgstr "Ви успішно зареєструвалися на Tvorcha Lavka. Ми раді бачити вас серед наших користувачів!"

msgid "Thank you for choosing us!"
msgstr "Дякуємо, що обрали нас!"

msgid "Go to shop"
msgstr "Перейти до магазину"

msgid "Please enter this code on the website to confirm your password recovery."
msgstr "Будь ласка, введіть цей код на сайті, щоб підтвердити відновлення паролю."

msgid "If you have not requested a password recovery, please ignore this email."
msgstr "Якщо ви не надсилали запит на відновлення паролю, будь ласка, ігноруйте цей лист."

msgid "Email already verified."
msgstr "Електронну пошту вже підтверджено."
