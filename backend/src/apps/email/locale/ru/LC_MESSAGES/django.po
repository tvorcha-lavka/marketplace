msgid "Email verification"
msgstr "Подтверждение электронной почты"

msgid "Password recovery"
msgstr "Восстановление пароля"

msgid "Hi! Your email verification code: <VERIFICATION_CODE>"
msgstr "Приветствую! Ваш код подтверждения электронной почты: <VERIFICATION_CODE>"

msgid "Please check your email to verify your account."
msgstr "Пожалуйста, проверьте свою электронную почту для подтверждения аккаунта."

msgid "Welcome to Tvorcha Lavka!"
msgstr "Добро пожаловать в Tvorcha Lavka!"

msgid "Hi! Thank you for registering on Tvorcha Lavka!"
msgstr "Приветствую! Спасибо за регистрацию на Tvorcha Lavka!"

msgid "Hi! Your password recovery code: <VERIFICATION_CODE>"
msgstr "Приветствую! Ваш код восстановления пароля: <VERIFICATION_CODE>"

msgid "A password recovery email has been sent to your email address."
msgstr "Письмо для восстановления пароля было отправлено на вашу электронную почту."

msgid "Your confirmation code:"
msgstr "Ваш код подтверждения:"

#, python-format
msgid "Code is valid for %(expire_in)s minutes."
msgstr "Срок действия кода - %(expire_in)s мин."

msgid "Please enter this code on the website to confirm your email address."
msgstr "Пожалуйста, введите этот код на сайте, чтобы подтвердить свою электронную почту."

msgid "If you have not requested this registration, please ignore this email."
msgstr "Если вы не запрашивали эту регистрацию, пожалуйста, проигнорируйте это письмо."

msgid "You have successfully registered for Tvorcha Lavka. We are glad to see you among our users!"
msgstr "Вы успешно зарегистрировались на Tvorcha Lavka. Мы рады видеть вас среди наших пользователей!"

msgid "Thank you for choosing us!"
msgstr "Спасибо, что выбрали нас!"

msgid "Go to shop"
msgstr "Перейти в магазин"

msgid "Please enter this code on the website to confirm your password recovery."
msgstr "Пожалуйста, введите этот код на сайте, чтобы подтвердить восстановление пароля."

msgid "If you have not requested a password recovery, please ignore this email."
msgstr "Если вы не запрашивали восстановление пароля, пожалуйста, игнорируйте это письмо."

msgid "Email already verified."
msgstr "Электронная почта уже подтверждена."
