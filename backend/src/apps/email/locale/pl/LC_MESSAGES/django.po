msgid "Email verification"
msgstr "Potwierdzenie e-mail"

msgid "Password recovery"
msgstr "Odzyskiwanie hasła"

msgid "Hi! Your email verification code: <VERIFICATION_CODE>"
msgstr "Witam! Kod weryfikacyjny e-mail: <VERIFICATION_CODE>"

msgid "Please check your email to verify your account."
msgstr "Sprawdź pocztę e-mail, aby potwierdzić swoje konto."

msgid "Welcome to Tvorcha Lavka!"
msgstr "Witamy w Tvorcha Lavka!"

msgid "Hi! Thank you for registering on Tvorcha Lavka!"
msgstr "Witam! Dziękujemy za rejestrację w Tvorcha Lavka!"

msgid "Hi! Your password recovery code: <VERIFICATION_CODE>"
msgstr "Witam! Twój kod odzyskiwania hasła: <VERIFICATION_CODE>"

msgid "A password recovery email has been sent to your email address."
msgstr "Wiadomość e-mail z prośbą o odzyskanie hasła została wysłana na Twój adres e-mail."

msgid "Your confirmation code:"
msgstr "Twój kod potwierdzający:"

#, python-format
msgid "Code is valid for %(expire_in)s minutes."
msgstr "Okres ważności kodu - %(expire_in)s min."

msgid "Please enter this code on the website to confirm your email address."
msgstr "Wprowadź ten kod na stronie internetowej, aby potwierdzić swój adres e-mail."

msgid "If you have not requested this registration, please ignore this email."
msgstr "Jeśli nie zażądałeś tej rejestracji, zignoruj tę wiadomość e-mail."

msgid "You have successfully registered for Tvorcha Lavka. We are glad to see you among our users!"
msgstr "Pomyślnie zarejestrowałeś się w Tvorcha Lavka. Cieszymy się, że jesteś wśród naszych użytkowników!"

msgid "Thank you for choosing us!"
msgstr "Dziękujemy za wybranie nas!"

msgid "Go to shop"
msgstr "Przejdź do sklepu"

msgid "Please enter this code on the website to confirm your password recovery."
msgstr "Wprowadź ten kod na stronie internetowej, aby potwierdzić odzyskanie hasła."

msgid "If you have not requested a password recovery, please ignore this email."
msgstr "Jeśli nie wnioskowałeś o odzyskanie hasła, zignoruj tę wiadomość e-mail."

msgid "Email already verified."
msgstr "Twój adres e-mail został już potwierdzony."
