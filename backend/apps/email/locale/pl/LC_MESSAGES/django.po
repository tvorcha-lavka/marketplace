#: .\apps\email\models.py:6
msgid "Email Verification"
msgstr "Potwierdzenie e-mail"

#: .\apps\email\models.py:7
msgid "Reset Password"
msgstr "Resetowanie hasła"

#: .\apps\email\tasks.py:19 .\apps\email\templates\email_verification.html:7
msgid "Email verification"
msgstr "Potwierdzenie e-mail"

#: .\apps\email\tasks.py:20
#, python-format
msgid ""
"Hi!\n"
"Your confirmation code: %(code)s"
msgstr ""
"Witam!\n"
"Kod potwierdzający: %(code)s"

#: .\apps\email\tasks.py:21
msgid "Please check your email to verify your account."
msgstr "Sprawdź pocztę e-mail, aby potwierdzić swoje konto."

#: .\apps\email\tasks.py:36 .\apps\email\templates\reset_password.html:7
msgid "Password change confirmation"
msgstr "Potwierdzenie zmiany hasła"

#: .\apps\email\tasks.py:37
#, python-format
msgid ""
"Hi %(username)s!\n"
"Your password change confirmation code: %(code)s"
msgstr ""
"Witam %(username)s!\n"
"Kod potwierdzenia zmiany hasła: %(code)s"

#: .\apps\email\tasks.py:42
msgid "A password reset email has been sent to your email address."
msgstr "Wiadomość e-mail z resetem hasła została wysłana na Twój adres e-mail."

#: .\apps\email\tasks.py:76
msgid "Welcome to Tvorcha Lavka!"
msgstr "Witamy w Tvorcha Lavka!"

#: .\apps\email\tasks.py:77
#, python-format
msgid "Hi, %(username)s. Thank you for registering Tvorcha Lavka!"
msgstr "Witam, %(username)s. Dziękujemy za rejestrację w Tvorcha Lavka!"

#: .\apps\email\templates\email_verification.html:12
msgid "Hi!"
msgstr "Witam!"

#: .\apps\email\templates\email_verification.html:15
msgid "Your confirmation code:"
msgstr "Kod potwierdzający:"

#: .\apps\email\templates\email_verification.html:19
#: .\apps\email\templates\reset_password.html:19
#, python-format
msgid "Code is valid for %(expire_in)s minutes."
msgstr "Okres ważności kodu - %(expire_in)s min."

#: .\apps\email\templates\email_verification.html:20
msgid "Please enter this code on the website to confirm your email address."
msgstr ""
"Wprowadź ten kod na stronie internetowej, aby potwierdzić swój adres e-mail."

#: .\apps\email\templates\email_verification.html:23
msgid "If you have not requested this verification, please ignore this email."
msgstr "Jeśli nie zażądałeś tej weryfikacji, zignoruj tę wiadomość e-mail."

#: .\apps\email\templates\reset_password.html:12
msgid "Hi, "
msgstr "Witam, "

#: .\apps\email\templates\reset_password.html:15
msgid "Your password change confirmation code:"
msgstr "Kod potwierdzenia zmiany hasła:"

#: .\apps\email\templates\reset_password.html:20
msgid "Please enter this code on the website to confirm the password change."
msgstr ""
"Wprowadź ten kod na stronie internetowej, aby potwierdzić zmianę hasła."

#: .\apps\email\templates\reset_password.html:23
msgid "If you have not requested a password change, please ignore this email."
msgstr "Jeśli nie wysłałeś prośby o zmianę hasła, zignoruj tę wiadomość."

#: .\apps\email\views.py:27
msgid "Email already verified."
msgstr "Twój adres e-mail został już potwierdzony."
