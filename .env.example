# --- Environment ------------------------------------------------------------------------------------------------------
# development, staging, production
ENV_STATE=development
# backend, frontend, not-set
LOCAL_DEV_SERVICE=not-set

# --- PostgreSQL -------------------------------------------------------------------------------------------------------
POSTGRES_DB=dev-database
POSTGRES_USER=avnadmin
POSTGRES_PASSWORD=__secret__
POSTGRES_HOST=marketplace-tvorcha-lavka.f.aivencloud.com
POSTGRES_PORT=25693
POSTGRES_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}"

# --- Django -----------------------------------------------------------------------------------------------------------
# To generate DJANGO_SECRET_KEY, use: https://djecrety.ir/
DJANGO_SECRET_KEY=__secret__
DJANGO_PORT=8000
FRONTEND_PORT=8080
ALLOWED_PROD_HOSTS='["tvorcha-lavka.com"]'
ALLOWED_DEV_HOSTS='["dev-domain.com", "dev-domain-2.com"]'

# --- Elasticsearch ----------------------------------------------------------------------------------------------------
ELASTIC_HOSTS='["http://elasticsearch:9200"]'
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=__secret__
ELASTIC_USE_SSL=false
ELASTIC_VERIFY_CERTS=true

# --- Frontend ---------------------------------------------------------------------------------------------------------
DEV_FRONTEND_URL=http://localhost:8080
PROD_FRONTEND_URL=https://tvorcha-lavka.com
API_URL=http://localhost:8000/
VITE_API_URL=http://localhost:8000/api

# --- Redis ------------------------------------------------------------------------------------------------------------
REDIS_PORT=6379
REDIS_BROKER_URL=redis://redis:6379/1

# --- RabbitMQ ---------------------------------------------------------------------------------------------------------
RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=admin

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_BROKER_URL="pyamqp://${RABBITMQ_DEFAULT_USER}:${RABBITMQ_DEFAULT_PASS}@${RABBITMQ_HOST}:${RABBITMQ_PORT}//"

# --- Celery -----------------------------------------------------------------------------------------------------------
CELERY_BROKER_URL="${RABBITMQ_BROKER_URL}"
CELERY_RESULT_BACKEND=rpc://

# --- Email ------------------------------------------------------------------------------------------------------------
EMAIL_HOST_USER=tvorcha.lavka.ua@gmail.com
EMAIL_HOST_PASSWORD=__secret__

# --- Google -----------------------------------------------------------------------------------------------------------
GOOGLE_OAUTH2_KEY=__secret__
GOOGLE_OAUTH2_SECRET=__secret__
# endpoint to complete google auth (frontend url)
GOOGLE_OAUTH2_REDIRECT_URI=/login/google/complete/

# --- Facebook ---------------------------------------------------------------------------------------------------------
FACEBOOK_APP_ID=__secret__
FACEBOOK_APP_SECRET=__secret__
# endpoint to complete facebook auth (frontend url)
FACEBOOK_OAUTH2_REDIRECT_URI=/login/facebook/complete/

# --- DeepL Translator -------------------------------------------------------------------------------------------------
DEEPL_API_KEY=__secret__

# --- AWS S3 Bucket ----------------------------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=__secret__
AWS_SECRET_ACCESS_KEY=__secret__
AWS_STORAGE_BUCKET_NAME=tvorcha-lavka
AWS_S3_REGION_NAME=eu-north-1

# Custom domain for media will be replaced with: media.tvorcha-lavka.com
AWS_S3_CUSTOM_DOMAIN="${AWS_STORAGE_BUCKET_NAME}.s3.amazonaws.com"
VITE_AWS_S3_CUSTOM_DOMAIN="${AWS_S3_CUSTOM_DOMAIN}"
